# Salin menjadi .env (berkas .env diabaikan Git). Hanya nilai yang ingin diubah yang perlu diisi.
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-kata-sandi-yang-kuat
PORT=3000
HOST=127.0.0.1

# --- Scan Import (lihat README) ---
SCAN_WORKER_URL=http://127.0.0.1:8000
# Harus sama dengan WORKER_TOKEN di worker Python. Wajib kecuali SCAN_DEV_MODE=true.
SCAN_WORKER_TOKEN=
# Hanya untuk pengembangan lokal (mengizinkan http://, fixture:// dan loopback). Jangan aktifkan di produksi.
SCAN_DEV_MODE=false
# Batas khusus jalur Scan Import (upload manual tidak terpengaruh)
SCAN_MAX_PAGES_PER_CHAPTER=300
SCAN_MAX_BYTES_PER_CHAPTER=157286400
SCAN_MAX_BYTES_PER_IMAGE=15728640
SCAN_MIN_FREE_BYTES=1073741824
SCAN_WORKER_UNREACHABLE_S=60
SCAN_DRAFT_EXPIRY_DAYS=7
