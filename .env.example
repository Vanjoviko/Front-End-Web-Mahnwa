# Salin menjadi .env (berkas .env diabaikan Git). Hanya nilai yang ingin diubah yang perlu diisi.
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-kata-sandi-yang-kuat
PORT=3000
HOST=127.0.0.1

# --- Scan Import (lihat README) ---
SCAN_WORKER_URL=http://127.0.0.1:8000
# Harus sama dengan WORKER_TOKEN di worker Python. Wajib kecuali SCAN_DEV_MODE=true.
SCAN_WORKER_TOKEN=
# Hanya untuk pengembangan lokal (mengizinkan http://, fixture:// dan loopback). Jangan aktifkan di produksi.
SCAN_DEV_MODE=false
# Batas khusus jalur Scan Import (upload manual tidak terpengaruh)
SCAN_MAX_PAGES_PER_CHAPTER=300
SCAN_MAX_BYTES_PER_CHAPTER=157286400
SCAN_MAX_BYTES_PER_IMAGE=15728640
SCAN_MIN_FREE_BYTES=1073741824
SCAN_WORKER_UNREACHABLE_S=60
SCAN_DRAFT_EXPIRY_DAYS=7

# --- Login akun pembaca (backend Python; FE hanya proksi/BFF) ---
# Aktifkan bila layanan auth backend berjalan. Bila false, tombol Masuk menampilkan pesan belum aktif.
AUTH_ENABLED=false
AUTH_BACKEND_URL=http://127.0.0.1:8000
# Batas waktu panggilan server-ke-server ke backend auth (milidetik).
AUTH_BACKEND_TIMEOUT_MS=8000

# --- Auto-Sync (langganan sumber seri) ---
# Scheduler otomatis; tombol "Sync" manual di admin tetap bisa dipakai bila false.
AUTO_SYNC_ENABLED=false
AUTO_SYNC_TICK_S=60
AUTO_SYNC_CONCURRENCY=1
AUTO_SYNC_MAX_NEW_PER_RUN=5
AUTO_SYNC_TIMEOUT_S=1800
AUTO_SYNC_DEFAULT_INTERVAL=360
AUTO_SYNC_JITTER_S=60
AUTO_SYNC_MAX_FAILURES=5
